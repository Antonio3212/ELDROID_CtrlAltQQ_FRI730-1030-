<!-- item_order.xml -->
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    android:padding="16dp"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="4dp"
    >

    <!-- LinearLayout for order details -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Customer Name with bold font -->
        <TextView
            android:id="@+id/text_customer_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="John Doe"
            android:textSize="16sp"
            android:textColor="#212121"
            android:fontFamily="sans-serif-medium"
            android:paddingBottom="8dp"
            android:textStyle="bold"
            android:lineSpacingExtra="4dp" />

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E0E0E0"
            android:layout_marginBottom="8dp"/>

        <!-- Shipping Address with icon -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingBottom="8dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/location"
                android:layout_marginEnd="8dp"
                app:tint="#757575" />

            <TextView
                android:id="@+id/text_shipping_address"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="123 Main Street, New York"
                android:textSize="14sp"
                android:textColor="#757575"
                android:lineSpacingExtra="4dp" />
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E0E0E0"
            android:layout_marginBottom="8dp"/>

        <!-- Payment Method with icon -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingBottom="8dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/payment"
                android:layout_marginEnd="8dp"
                app:tint="#757575" />

            <TextView
                android:id="@+id/text_payment_method"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Credit Card"
                android:textSize="14sp"
                android:textColor="#757575"
                android:lineSpacingExtra="4dp" />
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E0E0E0"
            android:layout_marginBottom="8dp"/>

        <!-- Total Price with bold font -->
        <TextView
            android:id="@+id/text_total_price"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="$120.00"
            android:textSize="16sp"
            android:textColor="#212121"
            android:textStyle="bold"
            android:lineSpacingExtra="4dp" />

    </LinearLayout>
</androidx.cardview.widget.CardView>
